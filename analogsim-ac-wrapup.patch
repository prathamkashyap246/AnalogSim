+def test_ac_dec_sweep_point_count():
+    _, p = build("Vin 1 0 0 AC 1\nR1 1 0 1k\n.ac dec 10 1 1e6")
+    assert len(p.ac.values()) == 61  # 6 decades * 10 + 1
