# Database
DATABASE_URL=postgresql://user:password@postgres:5432/analog_data_commons
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=analog_data_commons

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Analog Data Commons

# Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=analog-data

# ML
ML_MODEL_PATH=/app/ml/models
